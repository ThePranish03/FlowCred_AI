APP_NAME=FlowCred AI
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./flowcred.db
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Leave the data paths unset: app/main.py resolves them from the repository root,
# which works whether uvicorn is started from the repo root or from backend/.
# Setting ../models here silently breaks the documented root-cwd command.
# MODEL_DIR=/srv/flowcred/models
# DATA_DIR=/srv/flowcred/data
CORS_ORIGINS=http://localhost:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# For Compose set DATABASE_URL to the in-network URL in docker-compose.yml and use these:
POSTGRES_PASSWORD=replace_with_long_alphanumeric_secret
FRONTEND_PORT=8080
